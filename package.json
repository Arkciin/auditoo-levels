{
  "name": "auditoo-levels",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @repo/server --filter @repo/web dev",
    "build": "pnpm --filter @repo/web build && pnpm --filter @repo/server build",
    "start": "pnpm --filter @repo/server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @repo/web e2e",
    "e2e:postgres": "scripts/with-postgres.sh pnpm e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "size": "node scripts/bundle-size.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
